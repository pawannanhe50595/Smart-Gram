# SmartGram Environment Configuration
# Copy this file to '.env' and fill in your real keys

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=smartgram_secret_dev_key_do_not_use_in_prod

# Google OAuth Credentials
# Create these at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Microsoft OAuth Credentials (Optional)
# Create these at https://portal.azure.com/
MS_CLIENT_ID=your_ms_client_id_here
MS_CLIENT_SECRET=your_ms_client_secret_here
